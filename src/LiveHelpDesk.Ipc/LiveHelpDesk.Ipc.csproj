<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LiveHelpDesk.Ipc</RootNamespace>
    <!-- The interface is consumed through dynamic proxies; the source-generated contract mode is not needed. -->
    <NoWarn>$(NoWarn);StreamJsonRpc0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows-only (named pipe ACLs), but not a -windows TFM: that one drags the WPF runtime into a self-contained publish (via StreamJsonRpc). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveHelpDesk.Abstractions\LiveHelpDesk.Abstractions.csproj" />
  </ItemGroup>

</Project>
