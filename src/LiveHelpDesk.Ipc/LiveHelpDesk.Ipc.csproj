<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LiveHelpDesk.Ipc</RootNamespace>
    <!-- The interface is consumed through dynamic proxies; the source-generated contract mode is not needed. -->
    <NoWarn>$(NoWarn);StreamJsonRpc0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveHelpDesk.Abstractions\LiveHelpDesk.Abstractions.csproj" />
  </ItemGroup>

</Project>
