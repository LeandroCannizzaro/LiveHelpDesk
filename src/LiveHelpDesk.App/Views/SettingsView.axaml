<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveHelpDesk.App.ViewModels"
             xmlns:conv="using:LiveHelpDesk.App.Converters"
             x:Class="LiveHelpDesk.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Impostazioni" FontSize="20" FontWeight="SemiBold" />

      <TextBlock Text="Finestrella lampeggiante" FontWeight="SemiBold" Margin="0,8,0,0" />
      <CheckBox Content="Mostra la finestrella in alto quando c'è qualcosa da gestire" IsChecked="{Binding OverlayEnabled}" />
      <CheckBox Content="Suona un avviso per gli eventi critici" IsChecked="{Binding PlaySound}" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Schermo" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding Screen}" MinWidth="280" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Mostra un esempio" Command="{Binding ShowOverlayDemoCommand}" />
        <Button Content="Rimetti al centro" Command="{Binding ResetPositionCommand}" />
      </StackPanel>
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Si può trascinare con il mouse." />

      <TextBlock Text="Sospensione automatica" FontWeight="SemiBold" Margin="0,12,0,0" />
      <CheckBox Content="Sospendi gli avvisi durante presentazioni e condivisioni dello schermo" IsChecked="{Binding SuppressWhenPresenting}" />
      <CheckBox Content="Sospendi gli avvisi quando sei connesso a una VPN" IsChecked="{Binding SuppressWhenOnVpn}" />
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Mentre è sospeso non appaiono né la finestrella né le notifiche di Windows: quello che arriva viene conservato e mostrato nella finestrella appena finisci la presentazione o ti scolleghi dalla VPN." />


      <TextBlock Text="Colori della finestrella" FontWeight="SemiBold" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="150,220,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sfondo" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OverlayBackground}" PlaceholderText="#RRGGBB" />
        <Border Grid.Row="0" Grid.Column="2" Width="34" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="#55000000"
                Background="{Binding OverlayBackground, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Testo" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlayTextColor}" PlaceholderText="#RRGGBB" />
        <Border Grid.Row="1" Grid.Column="2" Width="34" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="#55000000"
                Background="{Binding OverlayTextColor, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Numero (accento)" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OverlayAccent}" PlaceholderText="#RRGGBB" />
        <Border Grid.Row="2" Grid.Column="2" Width="34" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="#55000000"
                Background="{Binding OverlayAccent, Converter={x:Static conv:HexColorToBrushConverter.Instance}}" />
      </Grid>
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Lascia vuoto per i colori automatici (ambra per i solleciti, rosso per gli eventi critici). Formato #RRGGBB." />

      <TextBlock Text="Avvio" FontWeight="SemiBold" Margin="0,12,0,0" />
      <CheckBox Content="Avvia LiveHelpDesk quando accedo a Windows (resta nell'area di notifica)" IsChecked="{Binding StartWithWindows}" />

      <TextBlock Text="{Binding Note}" Opacity="0.85" TextWrapping="Wrap"
                 IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding Updates, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="Aggiornamenti" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat='Versione installata: {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Controlla aggiornamenti" Command="{Binding Updates.CheckCommand}" />
          <Button Content="Aggiorna e riavvia" Classes="accent" Command="{Binding Updates.InstallCommand}"
                  IsVisible="{Binding Updates.CanInstall}" />
          <Button Content="Novità" Command="{Binding Updates.OpenReleaseNotesCommand}" IsVisible="{Binding Updates.IsAvailable}" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.Progress}" IsVisible="{Binding Updates.IsBusy}" MaxWidth="400"
                     HorizontalAlignment="Left" Width="400" />
        <TextBlock Text="{Binding Updates.Status}" Opacity="0.85" TextWrapping="Wrap"
                   IsVisible="{Binding Updates.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Opacity="0.65" TextWrapping="Wrap"
                   Text="LiveHelpDesk controlla da solo all'avvio e ogni qualche ora. L'aggiornamento non tocca impostazioni, regole e canali." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
