<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveHelpDesk.App.ViewModels"
             x:Class="LiveHelpDesk.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="Impostazioni" FontSize="20" FontWeight="SemiBold" />

      <TextBlock Text="Finestrella lampeggiante" FontWeight="SemiBold" Margin="0,8,0,0" />
      <CheckBox Content="Avvisi a video attivi (finestrella e notifiche di Windows)" IsChecked="{Binding OverlayEnabled}" />
      <CheckBox Content="Suona un avviso per gli eventi critici" IsChecked="{Binding PlaySound}" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Schermo" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding Screen}" MinWidth="280" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Mostra un esempio" Command="{Binding ShowOverlayDemoCommand}" />
        <Button Content="Rimetti al centro" Command="{Binding ResetPositionCommand}" />
      </StackPanel>
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Si può trascinare con il mouse." />

      <TextBlock Text="Sospensione automatica" FontWeight="SemiBold" Margin="0,12,0,0" />
      <CheckBox Content="Sospendi gli avvisi durante presentazioni e condivisioni dello schermo" IsChecked="{Binding SuppressWhenPresenting}" />
      <CheckBox Content="Sospendi gli avvisi quando sei connesso a una VPN" IsChecked="{Binding SuppressWhenOnVpn}" />
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Mentre è sospeso non appaiono né la finestrella né le notifiche di Windows: quello che arriva viene conservato e mostrato nella finestrella appena finisci la presentazione o ti scolleghi dalla VPN." />


      <TextBlock Text="Colori della finestrella" FontWeight="SemiBold" Margin="0,12,0,0" />
      <Grid ColumnDefinitions="150,160,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Sfondo" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OverlayBackground}" PlaceholderText="automatico" />
        <ColorPicker x:Name="BackgroundPicker" Grid.Row="0" Grid.Column="2" IsAlphaEnabled="False" IsAlphaVisible="False"
                     ToolTip.Tip="Scegli il colore dello sfondo" />
        <Button Grid.Row="0" Grid.Column="3" Content="Automatico" Command="{Binding ResetColorCommand}" CommandParameter="background" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Testo" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OverlayTextColor}" PlaceholderText="automatico" />
        <ColorPicker x:Name="TextPicker" Grid.Row="1" Grid.Column="2" IsAlphaEnabled="False" IsAlphaVisible="False"
                     ToolTip.Tip="Scegli il colore del testo" />
        <Button Grid.Row="1" Grid.Column="3" Content="Automatico" Command="{Binding ResetColorCommand}" CommandParameter="text" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Numero (accento)" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OverlayAccent}" PlaceholderText="automatico" />
        <ColorPicker x:Name="AccentPicker" Grid.Row="2" Grid.Column="2" IsAlphaEnabled="False" IsAlphaVisible="False"
                     ToolTip.Tip="Scegli il colore del numero" />
        <Button Grid.Row="2" Grid.Column="3" Content="Automatico" Command="{Binding ResetColorCommand}" CommandParameter="accent" />
      </Grid>
      <TextBlock Opacity="0.65" TextWrapping="Wrap"
                 Text="Scegli il colore con il selettore o scrivi il codice #RRGGBB. «Automatico» torna ai colori predefiniti (ambra per i solleciti, rosso per gli eventi critici)." />

      <TextBlock Text="Controllo dei nuovi eventi" FontWeight="SemiBold" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Cerca nuovi eventi ogni" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding PollSeconds}" Minimum="10" Maximum="3600" Increment="5" FormatString="0" Width="150"
                       IsEnabled="{Binding PollAvailable}" />
        <TextBlock Text="secondi" VerticalAlignment="Center" />
        <Button Content="Applica" Command="{Binding ApplyPollCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding PollNote}" Opacity="0.65" TextWrapping="Wrap"
                 IsVisible="{Binding PollNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Text="Avvio" FontWeight="SemiBold" Margin="0,12,0,0" />
      <CheckBox Content="Avvia LiveHelpDesk quando accedo a Windows (resta nell'area di notifica)" IsChecked="{Binding StartWithWindows}" />

      <TextBlock Text="Valori predefiniti" FontWeight="SemiBold" Margin="0,12,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Ripristina predefiniti" Command="{Binding AskResetCommand}" IsVisible="{Binding !ConfirmingReset}"
                ToolTip.Tip="Riporta tutte le opzioni di questa pagina ai valori iniziali (tranne l'avvio con Windows)" />
        <Button Content="Sì, ripristina" Classes="accent" Command="{Binding ResetDefaultsCommand}" IsVisible="{Binding ConfirmingReset}" />
        <Button Content="Annulla" Command="{Binding CancelResetCommand}" IsVisible="{Binding ConfirmingReset}" />
      </StackPanel>
      <TextBlock Text="Le tue scelte su finestrella, colori, sospensione e intervallo andranno perse."
                 Opacity="0.75" TextWrapping="Wrap" IsVisible="{Binding ConfirmingReset}" />

      <TextBlock Text="{Binding Note}" Opacity="0.85" TextWrapping="Wrap"
                 IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding Updates, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="Aggiornamenti" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat='Versione installata: {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Controlla aggiornamenti" Command="{Binding Updates.CheckCommand}" />
          <Button Content="Aggiorna e riavvia" Classes="accent" Command="{Binding Updates.InstallCommand}"
                  IsVisible="{Binding Updates.CanInstall}" />
          <Button Content="Note di rilascio" Command="{Binding Updates.OpenReleaseNotesCommand}"
                  ToolTip.Tip="Apre la pagina con le novità di ogni versione" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Updates.Progress}" IsVisible="{Binding Updates.IsBusy}" MaxWidth="400"
                     HorizontalAlignment="Left" Width="400" />
        <TextBlock Text="{Binding Updates.Status}" Opacity="0.85" TextWrapping="Wrap"
                   IsVisible="{Binding Updates.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Opacity="0.65" TextWrapping="Wrap"
                   Text="LiveHelpDesk controlla da solo all'avvio e ogni qualche ora. L'aggiornamento non tocca impostazioni, regole e canali." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
