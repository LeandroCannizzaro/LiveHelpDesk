<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveHelpDesk.App.ViewModels"
             x:Class="LiveHelpDesk.App.Views.EventsView"
             x:DataType="vm:EventsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="✓ Visti tutti" Command="{Binding AcknowledgeAllCommand}"
                ToolTip.Tip="Segna come visti tutti gli eventi dell'elenco" />
        <Button Content="Pulisci" Command="{Binding ClearCommand}"
                ToolTip.Tip="Svuota l'elenco: da ora compaiono solo gli eventi nuovi" />
      </StackPanel>
      <TextBlock Text="Eventi recenti" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <TextBlock Grid.Row="1" Text="{Binding Message}" Opacity="0.7" Margin="0,8"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" Background="Transparent"
             IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNullOrEmpty}}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EventRow">
          <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" Margin="0,4">
            <TextBlock Grid.Column="0" Text="{Binding When}" Opacity="0.7" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Number}" Opacity="0.7" />
              </StackPanel>
              <TextBlock Text="{Binding Title}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Content="Apri" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" />
              <Button Content="Vista" Command="{Binding AcknowledgeCommand}" IsVisible="{Binding CanAcknowledge}" />
              <TextBlock Text="✓ visto" Opacity="0.6" VerticalAlignment="Center" IsVisible="{Binding Acknowledged}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
