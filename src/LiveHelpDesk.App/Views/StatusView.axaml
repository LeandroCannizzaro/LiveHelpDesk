<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LiveHelpDesk.App.ViewModels"
             x:Class="LiveHelpDesk.App.Views.StatusView"
             x:DataType="vm:StatusViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Fill" Value="#9CA3AF" />
    </Style>
    <Style Selector="Ellipse.dot.ok"><Setter Property="Fill" Value="#16A34A" /></Style>
    <Style Selector="Ellipse.dot.warn"><Setter Property="Fill" Value="#F59E0B" /></Style>
    <Style Selector="Ellipse.dot.bad"><Setter Property="Fill" Value="#DC2626" /></Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="Servizio" FontSize="20" FontWeight="SemiBold" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Classes="dot" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
                 VerticalAlignment="Center" />
        <TextBlock Text="{Binding Headline}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Details}" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Error}" Foreground="#DC2626" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <Border Padding="16" CornerRadius="10" Background="#14808080" IsVisible="{Binding ShowLogin}">
        <StackPanel Spacing="10">
          <TextBlock Text="Accesso a Dynamics" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Opacity="0.85"
                     Text="Per controllare i ticket serve accedere una volta con il tuo account aziendale. L'accesso lo gestisce il servizio: l'app non vede mai la tua password né il token." />
          <Button Content="Accedi a Dynamics" Command="{Binding StartLoginCommand}"
                  IsVisible="{Binding !LoginPending}" HorizontalAlignment="Left" />
          <StackPanel Spacing="8" IsVisible="{Binding LoginPending}">
            <TextBlock Text="{Binding LoginCode}" FontSize="30" FontWeight="Bold" FontFamily="Consolas" />
            <TextBlock Text="{Binding LoginHelp}" TextWrapping="Wrap" Opacity="0.85" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Copia il codice" Command="{Binding CopyCodeCommand}" />
              <Button Content="Apri la pagina" Command="{Binding OpenLoginPageCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Canali di notifica" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ChannelRow">
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Detail}" Opacity="0.85" TextWrapping="Wrap" />
                <TextBlock Text="{Binding TestResult}" Opacity="0.7" TextWrapping="Wrap"
                           IsVisible="{Binding TestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <Button Grid.Column="2" Content="Prova" Command="{Binding TestCommand}" IsEnabled="{Binding Enabled}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Opacity="0.6" TextWrapping="Wrap"
                 Text="Le impostazioni dei canali si configurano per ora da riga di comando (LiveHelpDesk.Service channels-import)." />
    </StackPanel>
  </ScrollViewer>
</UserControl>
