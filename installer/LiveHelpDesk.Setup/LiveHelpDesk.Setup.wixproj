<Project Sdk="WixToolset.Sdk/5.0.2" ToolsVersion="4.0">
  <PropertyGroup>
    <OutputName>LiveHelpDesk</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>it-IT</Cultures>
    <!-- Both come from installer\build-msi.ps1: the published app folder and a numeric MSI version. -->
    <AppSource Condition="'$(AppSource)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\package\app</AppSource>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.1</ProductVersion>
    <IconSource>$(MSBuildThisFileDirectory)..\..\src\LiveHelpDesk.App\Assets\app.ico</IconSource>
    <InstallCounterSource>$(MSBuildThisFileDirectory)..\count-installation.ps1</InstallCounterSource>
    <DefineConstants>$(DefineConstants);AppSource=$(AppSource);ProductVersion=$(ProductVersion);IconSource=$(IconSource);InstallCounterSource=$(InstallCounterSource)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
